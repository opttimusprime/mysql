pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        string(
            name: 'GIT_COMMIT_SHA',
            defaultValue: '',
            description: 'Git Commit SHA received from CI pipeline'
        )
    }

    environment {
        AWS_REGION   = 'us-east-1'
        EKS_CLUSTER  = 'roboshop-dev-eks'
        NAMESPACE    = 'mysql'
        RELEASE_NAME = 'mysql'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    git checkout --detach "$GIT_COMMIT_SHA"
                    git log -1 --oneline
                '''
            }
        }

        stage('Configure Kubernetes') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                        --region "$AWS_REGION" \
                        --name "$EKS_CLUSTER"

                    kubectl get nodes
                '''
            }
        }

        stage('Deploy MySQL') {
            steps {
                sh '''
            helm upgrade --install "$RELEASE_NAME" ./helm \
                --namespace "$NAMESPACE" \
                --create-namespace \
                --wait \
                --timeout 15m
        '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl get statefulset -n "$NAMESPACE"
                    kubectl get pods -n "$NAMESPACE"
                    kubectl get svc -n "$NAMESPACE"
                    kubectl get pvc -n "$NAMESPACE"
                    kubectl get externalsecret -n "$NAMESPACE"
                '''
            }
        }
    }

    post {
        success {
            echo 'MySQL CD deployment successful'
        }

        failure {
            echo 'MySQL CD deployment failed'
        }
    }
}
